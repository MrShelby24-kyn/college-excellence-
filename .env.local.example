# Supabase — clés PUBLIQUES (exposées côté client, sans danger)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase — clé SECRÈTE (jamais exposée côté client, utilisée uniquement
# dans les Route Handlers pour des opérations d'administration)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL publique du site (utilisée pour le SEO / Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=https://www.excellence-divo-demo.ci
